# Copie este arquivo para .env.local e preencha os valores.
# O .env.local NUNCA vai para o Git (ver .gitignore).
# Variáveis com prefixo NEXT_PUBLIC_ vão para o navegador: nunca coloque segredos nelas.

# Supabase (painel do projeto > Project Settings > API Keys / Data API)
# URL do projeto, ex.: https://<id-do-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (começa com sb_publishable_). NUNCA a secret key (sb_secret_).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço público do site (domínio próprio); sem ele usa o da Vercel
# NEXT_PUBLIC_SITE_URL=https://seudominio.com.br
