# Copie este arquivo para .env.local e preencha os valores.
# O .env.local NUNCA vai para o Git (ver .gitignore).
# Variáveis com prefixo NEXT_PUBLIC_ vão para o navegador: nunca coloque segredos nelas.

# Supabase (painel do projeto > Project Settings > API Keys / Data API)
# URL do projeto, ex.: https://<id-do-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (começa com sb_publishable_). NUNCA a secret key (sb_secret_).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço público do site (domínio próprio); sem ele usa o da Vercel
# NEXT_PUBLIC_SITE_URL=https://seudominio.com.br

# ---- Só no servidor (NUNCA com NEXT_PUBLIC_) ----
# E-mail ao corretor a cada lead novo (issue #70). Sem as duas chaves o site
# funciona e salva os leads; só não manda o e-mail.
# Supabase secret key (painel > Project Settings > API Keys > Secret keys):
# lê o e-mail do corretor e o resumo da visita, que o visitante não pode ler.
# Obrigatória para o site gravar leads e visitas (#84): sem ela o tour abre,
# mas o formulário avisa que o envio está indisponível.
# SUPABASE_SECRET_KEY=sb_secret_...
# Resend (https://resend.com > API Keys):
# RESEND_API_KEY=re_...
# Remetente (opcional). Sem domínio próprio no Resend, o padrão
# onboarding@resend.dev só entrega para o e-mail da sua conta Resend.
# EMAIL_FROM=Vitrine 3D <avisos@seudominio.com.br>
